# Copy to .env or run: bash scripts/configure-local.sh
# All services must use the SAME randomly generated, base64-encoded 32-byte key.
JWT_SECRET_KEY=
DB_USERNAME=swiftapp
DB_PASSWORD=
SERVICE_BIND_ADDRESS=127.0.0.1
SERVICE_ADVERTISE_ADDRESS=127.0.0.1
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_URL=http://localhost:8761/eureka/

# Optional provider integrations. Payments need your own Razorpay test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=

# Local email is captured by Mailpit; no SMTP account is needed.
SWIFTAPP_CAPTURE_EMAILS=1
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Enable only after configuring your own Firebase Admin credentials.
PUSH_ENABLED=false
FIREBASE_CREDENTIALS=

